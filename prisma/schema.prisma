model Warranty {
  id             Int             @id @default(autoincrement())
  warrantyCode   String          @unique(map: "Warranty_warrantyCode_key") @db.VarChar(50)
  saleId         Int
  productId      Int
  customerId     Int?
  customerName   String?         @db.VarChar(150)
  customerPhone  String?         @db.VarChar(30)
  startDate      DateTime        @default(now())
  durationMonths Int             @default(0)
  expiryDate     DateTime
  status         warranty_status @default(ACTIVE)
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sale           sale            @relation(fields: [saleId], references: [id], onDelete: Cascade, map: "Warranty_saleId_fkey")
  product        product         @relation(fields: [productId], references: [id], map: "Warranty_productId_fkey")
  customer       customer?       @relation(fields: [customerId], references: [id], map: "Warranty_customerId_fkey")
  claims         WarrantyClaim[]

  @@index([warrantyCode], map: "Warranty_warrantyCode_idx")
  @@index([saleId], map: "Warranty_saleId_idx")
  @@index([productId], map: "Warranty_productId_idx")
  @@index([customerId], map: "Warranty_customerId_idx")
  @@index([customerPhone], map: "Warranty_customerPhone_idx")
  @@index([status], map: "Warranty_status_idx")
  @@index([expiryDate], map: "Warranty_expiryDate_idx")

  @@map("Warranty")
}

model WarrantyClaim {
  id           Int                   @id @default(autoincrement())
  claimNo      String                @unique(map: "WarrantyClaim_claimNo_key") @db.VarChar(50)
  warrantyId   Int
  issue        String                @db.Text
  actionTaken  String?               @db.Text
  status       warranty_claim_status @default(PENDING)
  handledById  Int?
  claimDate    DateTime              @default(now())
  resolvedDate DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  warranty     Warranty              @relation(fields: [warrantyId], references: [id], onDelete: Cascade, map: "WarrantyClaim_warrantyId_fkey")
  user         User?                 @relation(fields: [handledById], references: [id], map: "WarrantyClaim_handledById_fkey")

  @@index([warrantyId], map: "WarrantyClaim_warrantyId_idx")
  @@index([claimNo], map: "WarrantyClaim_claimNo_idx")
  @@index([status], map: "WarrantyClaim_status_idx")

  @@map("WarrantyClaim")
}

enum warranty_status {
  ACTIVE
  EXPIRED
  CLAIMED
  VOID
}

enum warranty_claim_status {
  PENDING
  IN_PROGRESS
  REPLACED
  REPAIRED
  REJECTED
  RESOLVED
}
